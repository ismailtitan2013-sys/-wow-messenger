# ===== СЕРВЕР (server/.env) =====

# Порт, на котором запускается сервер
PORT=5000

# Режим работы: development / production
NODE_ENV=production

# MongoDB — строка подключения к базе данных
# Для MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/wow-messenger
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/wow-messenger

# Секретный ключ для JWT токенов (придумайте длинную случайную строку)
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# URL фронтенда для CORS. Через запятую если несколько. Или * для всех.
CLIENT_URL=https://wow-30c41.web.app

# Firebase Admin SDK — Service Account JSON (вставить всю JSON строку)
# Скачать из Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Вставьте содержимое файла в одну строку:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"wow-30c41","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
